{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/pkg/(.*)",
      "headers": { "Cache-Control": "max-age=31536000, immutable" },
      "dest": "/pkg/$1"
    },
    {
      "src": "/ui/(.*)",
      "dest": "/ui/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/ui/index.html"
    }
  ]
}